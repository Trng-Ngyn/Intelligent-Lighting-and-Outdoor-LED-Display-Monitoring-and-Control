FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PYTHONPATH=/app/src:/app/src/backend
COPY requirements-w5.txt requirements-staging.txt ./
COPY src/ingestion/requirements.txt src/ingestion/requirements.txt
RUN pip install --no-cache-dir -r requirements-staging.txt && useradd -u 10001 -M app
COPY src/backend/ src/backend/
COPY src/iot_protocol/ src/iot_protocol/
COPY src/ingestion/ src/ingestion/
COPY src/staging_api/ src/staging_api/
COPY docs/data_contracts/001_init.sql docs/data_contracts/001_init.sql
COPY docs/data_contracts/schemas/ docs/data_contracts/schemas/
COPY sql/ sql/
COPY database/staging/ database/staging/
COPY tools/staging/ tools/staging/
USER 10001
CMD ["uvicorn","staging_api.main:app","--host","0.0.0.0","--port","8000","--workers","1"]
