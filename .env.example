# Các biến môi trường ghi đè config.json.
# Lưu ý: code đọc trực tiếp biến môi trường, KHÔNG tự nạp file .env.
# Hãy export biến trong shell hoặc dùng docker compose --env-file.

# Đường dẫn file cấu hình JSON.
SIM_CONFIG=config.json

# Khóa gốc để dẫn xuất khóa HMAC cho từng thiết bị.
# KHÔNG commit khóa thật. Chỉ dùng giá trị dev/test ở đây.
SIM_SIGNING_SECRET=dev-only-change-me-please-32chars

# Broker MQTT 5.
SIM_BROKER_HOST=broker.emqx.io
SIM_BROKER_PORT=1883
SIM_BROKER_USERNAME=
SIM_BROKER_PASSWORD=
SIM_BROKER_TLS=false

# Thông số simulator.
SIM_LOG_LEVEL=INFO
SIM_TELEMETRY_INTERVAL_SEC=15
SIM_KEEP_ALIVE_SEC=15
SIM_REPLAY_WINDOW_MS=30000

# Giới hạn số thiết bị (dùng khi test nhanh). Để trống = không giới hạn.
SIM_MAX_DEVICES=

# Tự thoát không gửi DISCONNECT sau N giây để kiểm thử LWT.
# Để trống = chạy bình thường.
SIM_CRASH_AFTER_SEC=
