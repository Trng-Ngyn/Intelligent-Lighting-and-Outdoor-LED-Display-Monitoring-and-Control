# Leave empty in development to use Vite proxy. For deployed frontend, set HTTPS API origin or reverse-proxy /api.
VITE_API_BASE_URL=
STAGING_PROXY_TARGET=http://127.0.0.1:8000
# Optional for ADMIN; REQUIRED for non-ADMIN users (also needs a lighting.users_roles row). Not a substitute for server-side authorization.
VITE_TENANT_ID=
VITE_SITE_ID=

# Backend Staging Complete uses `brightness` (brightness_pct => HTTP 422). SCRUM-19 OpenAPI spec says brightness_pct.
VITE_DIM_FIELD=brightness
