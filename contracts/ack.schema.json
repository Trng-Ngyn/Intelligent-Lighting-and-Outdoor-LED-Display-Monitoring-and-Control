{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pccom.example/v1/ack.json",
  "title": "PCCOM v1 ack",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "environment": {
      "enum": [
        "dev",
        "staging",
        "production"
      ]
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "gateway_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "device_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "status": {
      "enum": [
        "acknowledged",
        "executed",
        "verified",
        "rejected",
        "expired",
        "failed",
        "unknown"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "observed_value": {
      "type": [
        "number",
        "boolean"
      ]
    },
    "evidence_source": {
      "enum": [
        "gateway_journal",
        "adapter",
        "device_feedback",
        "independent_measurement"
      ]
    }
  },
  "required": [
    "schema_version",
    "environment",
    "tenant_id",
    "site_id",
    "gateway_id",
    "message_id",
    "command_id",
    "asset_id",
    "device_time",
    "status",
    "evidence_source"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        }
      },
      "then": {
        "required": [
          "observed_value"
        ],
        "properties": {
          "evidence_source": {
            "enum": [
              "device_feedback",
              "independent_measurement"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "rejected",
              "expired",
              "failed",
              "unknown"
            ]
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ]
}
