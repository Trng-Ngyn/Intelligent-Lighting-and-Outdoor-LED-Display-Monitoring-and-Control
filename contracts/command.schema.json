{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pccom.example/v1/command.json",
  "title": "PCCOM v1 command",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "environment": {
      "enum": [
        "dev",
        "staging",
        "production"
      ]
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "gateway_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "command_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "group_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "actor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "approval_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "action": {
      "enum": [
        "set_level",
        "set_power"
      ]
    },
    "value": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "boolean"
        }
      ]
    },
    "policy_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "control_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "target_rev": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "priority": {
      "enum": [
        "normal",
        "emergency"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    }
  },
  "required": [
    "schema_version",
    "environment",
    "tenant_id",
    "site_id",
    "gateway_id",
    "command_id",
    "actor",
    "asset_id",
    "action",
    "value",
    "policy_version",
    "control_epoch",
    "target_rev",
    "issued_at",
    "expires_at",
    "priority"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "set_level"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "integer"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "set_power"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "priority": {
            "const": "emergency"
          }
        }
      },
      "then": {
        "required": [
          "approval_ref",
          "reason"
        ]
      }
    }
  ]
}
