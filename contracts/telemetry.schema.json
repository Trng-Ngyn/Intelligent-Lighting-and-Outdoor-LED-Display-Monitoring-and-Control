{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pccom.example/v1/telemetry.json",
  "title": "PCCOM v1 telemetry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "environment": {
      "enum": [
        "dev",
        "staging",
        "production"
      ]
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "gateway_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "message_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "asset_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "source_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "metric": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "value": {
      "type": [
        "number",
        "boolean",
        "string",
        "null"
      ],
      "maxLength": 120
    },
    "unit": {
      "enum": [
        "W",
        "Wh",
        "V",
        "A",
        "C",
        "lx",
        "s",
        "pct",
        "none"
      ]
    },
    "quality": {
      "enum": [
        "measured",
        "estimated",
        "missing",
        "invalid"
      ]
    },
    "firmware": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": [
    "schema_version",
    "environment",
    "tenant_id",
    "site_id",
    "gateway_id",
    "message_id",
    "asset_id",
    "source_time",
    "sequence",
    "metric",
    "value",
    "unit",
    "quality",
    "firmware"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "quality": {
            "const": "missing"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "quality": {
            "enum": [
              "measured",
              "estimated"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": [
              "number",
              "boolean",
              "string"
            ]
          }
        }
      }
    }
  ]
}
