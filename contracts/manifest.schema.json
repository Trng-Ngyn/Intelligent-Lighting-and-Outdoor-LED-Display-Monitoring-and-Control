{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.pccom.example/v1/manifest.json",
  "title": "PCCOM v1 manifest",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "environment": {
      "enum": [
        "dev",
        "staging",
        "production"
      ]
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "site_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "player_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9_-]*$"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "object_key": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "media_type": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "width_px": {
            "type": "integer",
            "minimum": 1
          },
          "height_px": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "object_key",
          "sha256",
          "size_bytes",
          "media_type",
          "width_px",
          "height_px"
        ]
      }
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "approver": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "starts_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "ends_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "time_zone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "brightness_policy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "fallback_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "revocation_version": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "schema_version",
    "environment",
    "tenant_id",
    "site_id",
    "manifest_id",
    "version",
    "player_ids",
    "files",
    "author",
    "approver",
    "starts_at",
    "ends_at",
    "time_zone",
    "brightness_policy",
    "fallback_id",
    "revocation_version"
  ]
}
