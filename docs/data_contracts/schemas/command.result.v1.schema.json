{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pccom:w3-de:v1:command.result",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "message_type": {
      "const": "command.result"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "site_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "result_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "command_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "asset_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "device_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "device_time": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z(?![\\s\\S])"
        },
        {
          "type": "null"
        }
      ]
    },
    "received_time": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z(?![\\s\\S])"
    },
    "clock_quality": {
      "type": "string",
      "enum": [
        "synced",
        "uncertain"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "acknowledged",
        "executed",
        "verified",
        "rejected",
        "expired",
        "failed",
        "unknown"
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_value": {
      "anyOf": [
        {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "power"
                },
                "value": {
                  "type": "boolean"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "dimming_pct"
                },
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "brightness_pct"
                },
                "value": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "manifest_id"
                },
                "value": {
                  "type": "string",
                  "minLength": 36,
                  "maxLength": 36,
                  "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "const": "schedule_id"
                },
                "value": {
                  "type": "string",
                  "minLength": 36,
                  "maxLength": 36,
                  "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                }
              },
              "required": [
                "kind",
                "value"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_source": {
      "type": "string",
      "enum": [
        "none",
        "device_reported",
        "player_reported",
        "independent_sensor"
      ]
    }
  },
  "required": [
    "schema_version",
    "message_type",
    "tenant_id",
    "site_id",
    "result_id",
    "command_id",
    "asset_id",
    "device_id",
    "device_time",
    "received_time",
    "clock_quality",
    "status",
    "reason",
    "observed_value",
    "evidence_source"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "rejected",
              "expired",
              "failed",
              "unknown"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "clock_quality": {
            "const": "synced"
          }
        },
        "required": [
          "clock_quality"
        ]
      },
      "then": {
        "properties": {
          "device_time": {
            "type": "string",
            "format": "date-time",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z(?![\\s\\S])"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "acknowledged"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence_source": {
            "const": "none"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "clock_quality": {
            "const": "synced"
          },
          "observed_value": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "power"
                  },
                  "value": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "dimming_pct"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "brightness_pct"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "manifest_id"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 36,
                    "maxLength": 36,
                    "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "schedule_id"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 36,
                    "maxLength": 36,
                    "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_source": {
            "const": "none"
          }
        },
        "required": [
          "evidence_source"
        ]
      },
      "then": {
        "properties": {
          "observed_value": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "observed_value": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "power"
                  },
                  "value": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "dimming_pct"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "brightness_pct"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 100
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "manifest_id"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 36,
                    "maxLength": 36,
                    "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "const": "schedule_id"
                  },
                  "value": {
                    "type": "string",
                    "minLength": 36,
                    "maxLength": 36,
                    "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
                  }
                },
                "required": [
                  "kind",
                  "value"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_source": {
            "const": "player_reported"
          }
        },
        "required": [
          "evidence_source"
        ]
      },
      "then": {
        "properties": {
          "observed_value": {
            "type": "object",
            "properties": {
              "kind": {
                "const": "manifest_id"
              },
              "value": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
              }
            },
            "required": [
              "kind",
              "value"
            ],
            "additionalProperties": false
          }
        }
      }
    }
  ]
}
