{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pccom:w3-de:v1:command.request",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "message_type": {
      "const": "command.request"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "site_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "command_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
    },
    "actor": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "user",
            "service"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "asset",
            "group",
            "zone"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "action": {
      "type": "string",
      "enum": [
        "set_power",
        "set_dimming",
        "set_brightness",
        "apply_schedule",
        "activate_manifest",
        "revoke_manifest"
      ]
    },
    "requested_value": {},
    "policy_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "\\S"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z(?![\\s\\S])"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z(?![\\s\\S])"
    },
    "priority": {
      "type": "string",
      "enum": [
        "schedule",
        "operator",
        "approved_override",
        "emergency"
      ]
    },
    "approval_required": {
      "type": "boolean"
    },
    "approval_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 36,
          "maxLength": 36,
          "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "message_type",
    "tenant_id",
    "site_id",
    "command_id",
    "actor",
    "target",
    "action",
    "requested_value",
    "policy_version",
    "issued_at",
    "expires_at",
    "priority",
    "approval_required",
    "approval_ref"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "set_power"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "requested_value": {
            "type": "boolean"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "set_dimming"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "requested_value": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "set_brightness"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "requested_value": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "apply_schedule"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "requested_value": {
            "type": "object",
            "properties": {
              "schedule_id": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
              },
              "schedule_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "time_zone": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80,
                "pattern": "^(UTC|[A-Za-z_+-]+(/[A-Za-z0-9_+.-]+)+)(?![\\s\\S])",
                "format": "iana-time-zone"
              }
            },
            "required": [
              "schedule_id",
              "schedule_version",
              "time_zone"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "activate_manifest"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "requested_value": {
            "type": "object",
            "properties": {
              "manifest_id": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
              },
              "version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              },
              "sha256": {
                "type": "string",
                "minLength": 64,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "manifest_id",
              "version",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "const": "revoke_manifest"
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "requested_value": {
            "type": "object",
            "properties": {
              "manifest_id": {
                "type": "string",
                "minLength": 36,
                "maxLength": 36,
                "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
              },
              "revocation_version": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2147483647
              }
            },
            "required": [
              "manifest_id",
              "revocation_version"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval_required": {
            "const": true
          }
        },
        "required": [
          "approval_required"
        ]
      },
      "then": {
        "properties": {
          "approval_ref": {
            "type": "string",
            "minLength": 36,
            "maxLength": 36,
            "pattern": "^[0-9a-f]{8}(-[0-9a-f]{4}){3}-[0-9a-f]{12}$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "approval_required": {
            "const": false
          }
        },
        "required": [
          "approval_required"
        ]
      },
      "then": {
        "properties": {
          "approval_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "priority": {
            "type": "string",
            "enum": [
              "approved_override",
              "emergency"
            ]
          }
        },
        "required": [
          "priority"
        ]
      },
      "then": {
        "properties": {
          "approval_required": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "activate_manifest",
              "revoke_manifest"
            ]
          }
        },
        "required": [
          "action"
        ]
      },
      "then": {
        "properties": {
          "approval_required": {
            "const": true
          }
        }
      }
    }
  ]
}
