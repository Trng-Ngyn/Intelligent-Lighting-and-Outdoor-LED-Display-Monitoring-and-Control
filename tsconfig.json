{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "skipLibCheck": true, "isolatedModules": true, "noEmit": true, "allowImportingTsExtensions": true
  },
  "include": ["src/main.tsx", "src/App.tsx", "src/console/**/*.ts", "src/console/**/*.tsx"]
}
